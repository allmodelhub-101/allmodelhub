# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Providers
APIMODELS_API_KEY=
APIMODELS_BASE_URL=https://api.apimodels.app/v1
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLBACK_SECRET=
# Keep only during a controlled rotation window, then remove.
CALLBACK_SECRET_PREVIOUS=
# Vercel sends this as Authorization: Bearer <CRON_SECRET> to internal cron routes.
CRON_SECRET=
# Comma-separated provider/CDN hostnames only. Wildcards and URLs are not accepted.
PROVIDER_ASSET_HOST_ALLOWLIST=
HAIMAKER_API_KEY=
HAIMAKER_BASE_URL=https://api.haimaker.ai/v1
HAIMAKER_MODEL_MAP_JSON={}

# Wallet and payments
INTERNAL_USD_PKR=310
# Server-only comparison mode. Records legacy-vs-V2 results but never charges twice.
BILLING_V2_SHADOW_VALIDATION=false
EASYPAISA_ACCOUNT_TITLE=
EASYPAISA_ACCOUNT_NUMBER=
MEEZAN_ACCOUNT_TITLE=
MEEZAN_ACCOUNT_NUMBER=
MEEZAN_IBAN=
ADMIN_BOOTSTRAP_EMAIL=

# Rate limiting (optional locally, required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only release metadata
LEGAL_REVIEWED=false
